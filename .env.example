OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_MAX_OUTPUT_TOKENS=256
RAG_CHUNK_SIZE=2400
RAG_CHECK_INTERVAL_DAYS=7
TESSERACT_LANG=eng+hin
# Per-page OCR safety limits. Keep scale at 3 for regulatory-document accuracy.
OCR_RENDER_SCALE=3
OCR_TIMEOUT_SECONDS=120
# Set only when Tesseract is not available on PATH.
TESSERACT_CMD=
